#!/bin/sh
DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"

if [ -x "$DIR/.local/node/bin/node" ]; then
  NODE="$DIR/.local/node/bin/node"
else
  NODE="$(command -v node)"
fi

if [ -z "$NODE" ]; then
  echo "Node.js is required. Install Node 20+ and run npm install first." >&2
  exit 1
fi

exec "$NODE" "$DIR/node_modules/@stripe/cli/bin/shim.js" "$@"
